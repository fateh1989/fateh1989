<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YM — يم"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="دولاب صغير لجدولة TikTok. بعد إنشاء الخطة يمكن إطفاء الهاتف."
            android:textSize="15sp" />

        <EditText
            android:id="@+id/workerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Worker URL — https://...workers.dev"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/pairToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز الاقتران"
            android:inputType="textPassword" />

        <Button android:id="@+id/saveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حفظ الاتصال" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/connectTikTok" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ربط TikTok" />
            <Button android:id="@+id/refreshAccounts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تحديث الحسابات" />
        </LinearLayout>

        <Spinner android:id="@+id/accountSpinner" android:layout_width="match_parent" android:layout_height="48dp" />
        <Button android:id="@+id/pickVideos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="اختيار فيديوهات الدولاب" />
        <TextView android:id="@+id/videoCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 فيديو" />
        <EditText android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="كابتشن افتراضي (اختياري)" android:inputType="textMultiLine" />
        <EditText android:id="@+id/dailyCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عدد المنشورات يوميًا" android:inputType="number" android:text="1" />
        <EditText android:id="@+id/windowStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="بداية النافذة HH:mm" android:text="18:00" />
        <EditText android:id="@+id/windowEnd" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نهاية النافذة HH:mm" android:text="23:00" />
        <EditText android:id="@+id/horizonDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عدد الأيام" android:inputType="number" android:text="30" />
        <Button android:id="@+id/testOnePost" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="اختبار منشور واحد (+10 دقائق)" />
        <Button android:id="@+id/checkLastPost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحقق من آخر نتيجة" />
        <Button android:id="@+id/createPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="أنشئ الخطة السحابية" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="جاهز" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
