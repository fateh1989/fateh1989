<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/feedVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/feedPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="40dp"
        android:text="YM\n\nاختر فيديوهات الدولاب من زر +\nثم اسحب للأعلى والأسفل بينها"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/followingTab"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="يتابع"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/forYouTab"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="لك"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sideRail"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profileBubble"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bubble_bg"
            android:gravity="center"
            android:text="YM"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/likeButton"
            android:layout_width="64dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="♡\n0"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/commentButton"
            android:layout_width="64dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="●\nتعليق"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="64dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="☆\nحفظ"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/shareButton"
            android:layout_width="64dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="↗\nمشاركة"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="78dp"
        android:layout_marginEnd="88dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/feedAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@YM"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/feedCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:text="الدولاب جاهز لاستقبال الفيديوهات"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bubbleMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="82dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubbleWheel"
                style="@style/YmBubble"
                android:text="دولاب" />
            <TextView
                android:id="@+id/bubbleSchedule"
                style="@style/YmBubble"
                android:text="جدولة" />
            <TextView
                android:id="@+id/bubbleAccounts"
                style="@style/YmBubble"
                android:text="حسابات" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubbleProof"
                style="@style/YmBubble"
                android:text="اختبار" />
            <TextView
                android:id="@+id/bubbleHistory"
                style="@style/YmBubble"
                android:text="سجل" />
            <TextView
                android:id="@+id/bubbleSettings"
                style="@style/YmBubble"
                android:text="ضبط" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="#E6000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/homeNav"
            style="@style/YmBottomNav"
            android:text="⌂\nالرئيسية" />
        <TextView
            android:id="@+id/discoverNav"
            style="@style/YmBottomNav"
            android:text="⌕\nاكتشف" />

        <TextView
            android:id="@+id/plusButton"
            android:layout_width="64dp"
            android:layout_height="46dp"
            android:background="@drawable/plus_bg"
            android:gravity="center"
            android:text="＋"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyNav"
            style="@style/YmBottomNav"
            android:text="◷\nالسجل" />
        <TextView
            android:id="@+id/profileNav"
            style="@style/YmBottomNav"
            android:text="◉\nأنا" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controlSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="82dp"
        android:layout_marginBottom="76dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/sheet_bg"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sheetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YM"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/closeSheet"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelWheel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <Button android:id="@+id/pickVideos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختيار فيديوهات الدولاب" />
                    <TextView android:id="@+id/videoCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="0 فيديو" android:textColor="#FFFFFF" />
                    <EditText android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="كابتشن افتراضي" android:inputType="textMultiLine" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <EditText android:id="@+id/dailyCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عدد المنشورات يوميًا" android:inputType="number" android:text="1" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <EditText android:id="@+id/windowStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="بداية النافذة HH:mm" android:text="18:00" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <EditText android:id="@+id/windowEnd" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نهاية النافذة HH:mm" android:text="23:00" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <EditText android:id="@+id/horizonDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عدد الأيام" android:inputType="number" android:text="30" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <Button android:id="@+id/createPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="أنشئ الخطة السحابية" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <Spinner android:id="@+id/accountSpinner" android:layout_width="match_parent" android:layout_height="54dp" />
                    <Button android:id="@+id/connectTikTok" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ربط TikTok" />
                    <Button android:id="@+id/refreshAccounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحديث الحسابات" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelProof"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <Button android:id="@+id/testOnePost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختبار منشور واحد (+10 دقائق)" />
                    <Button android:id="@+id/checkLastPost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحقق من آخر نتيجة" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="هنا تظهر نتيجة آخر نشر وحالة الخطة." android:textColor="#FFFFFF" />
                    <Button android:id="@+id/historyRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحديث آخر نتيجة" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panelConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <EditText android:id="@+id/workerUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Worker URL — https://...workers.dev" android:inputType="textUri" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <EditText android:id="@+id/pairToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="رمز الاقتران" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
                    <Button android:id="@+id/saveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حفظ الاتصال" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:text="جاهز"
                    android:textColor="#FFFFFF"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
